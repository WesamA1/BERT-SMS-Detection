# Makes the summary table and figures for experiment 1

import json
from pathlib import Path

import numpy as np
import pandas as pd
import matplotlib
matplotlib.use("Agg")  # just save images, don't open windows
import matplotlib.pyplot as plt

results_dir = Path(__file__).parent / "results"

labels = {"frozen": "Frozen BERT", "finetuned": "Fine-tuned BERT"}
colors = {"frozen": "#2a78d6", "finetuned": "#eb6834"}
metrics = {"accuracy": "Accuracy", "spam_precision": "Spam precision",
           "spam_recall": "Spam recall", "spam_f1": "Spam F1"}

plt.rcParams.update({
    "font.size": 12,
    "axes.spines.top": False,
    "axes.spines.right": False,
    "axes.grid": True,
    "grid.color": "#e4e3dd",
    "axes.axisbelow": True,
    "figure.dpi": 150,
    "savefig.bbox": "tight",
})


def load_runs():
    runs = {}
    for f in sorted(results_dir.glob("*_seed*.json")):
        r = json.loads(f.read_text())
        runs.setdefault(r["setup"], []).append(r)
    if not runs:
        raise SystemExit(f"no results in {results_dir}, run experiment1.py first")
    return {name: runs[name] for name in labels if name in runs}  # frozen first


def summarize(runs):
    rows = []
    for name, rs in runs.items():
        row = {"setup": labels[name], "runs": len(rs)}
        for key in metrics:
            vals = [r["test"][key] for r in rs]
            row[key] = np.mean(vals)
            row[key + "_std"] = np.std(vals, ddof=1) if len(vals) > 1 else 0
        row["trainable_params"] = rs[0]["trainable_params"]
        row["sec_per_epoch"] = np.mean([r["mean_epoch_time_s"] for r in rs])
        mems = [r["peak_gpu_mem_mb"] for r in rs if r["peak_gpu_mem_mb"]]
        row["peak_gpu_mb"] = np.mean(mems) if mems else None
        rows.append(row)
    return pd.DataFrame(rows)


def table_image(summary, n_seeds):
    cells = []
    for _, r in summary.iterrows():
        row = [r["setup"]]
        row += [f"{r[k]:.3f} ± {r[k + '_std']:.3f}" for k in metrics]
        p = r["trainable_params"]
        row.append(f"{p / 1e6:.1f} M" if p >= 1e6 else f"{p / 1e3:.0f} K")
        row.append(f"{r['sec_per_epoch']:.1f} s")
        row.append(f"{r['peak_gpu_mb'] / 1024:.1f} GB" if r["peak_gpu_mb"] else "n/a")
        cells.append(row)

    header = ["Setup", "Accuracy", "Spam\nprecision", "Spam\nrecall", "Spam F1",
              "Trainable\nparams", "Time per\nepoch", "Peak GPU\nmemory"]
    widths = [0.17, 0.13, 0.13, 0.13, 0.13, 0.10, 0.10, 0.11]

    fig, ax = plt.subplots(figsize=(15, 0.6 + 0.55 * (len(cells) + 1)))
    ax.axis("off")
    table = ax.table(cellText=cells, colLabels=header, colWidths=widths,
                     loc="center", cellLoc="center")
    table.auto_set_font_size(False)
    table.set_fontsize(12)
    table.scale(1, 2.2)

    # only horizontal lines, bold header, setup names in their chart color
    names = list(labels)
    for (r, c), cell in table.get_celld().items():
        cell.visible_edges = "B"
        cell.set_edgecolor("#e4e3dd")
        if r == 0:
            cell.set_text_props(weight="bold")
            cell.set_edgecolor("#6b6a64")
            cell.set_height(cell.get_height() * 1.3)
        elif c == 0:
            cell.set_text_props(weight="bold", color=colors[names[r - 1]])

    ax.set_title(f"Mean ± standard deviation across {n_seeds} seeds",
                 fontsize=11, color="#6b6a64", loc="left")
    fig.savefig(results_dir / "summary_table.png")
    plt.close(fig)


def metrics_chart(runs, n_seeds):
    fig, ax = plt.subplots(figsize=(10, 5))
    x = np.arange(len(metrics))
    width = 0.8 / len(runs)

    for i, (name, rs) in enumerate(runs.items()):
        vals = np.array([[r["test"][k] for k in metrics] for r in rs])
        mean, lo, hi = vals.mean(0), vals.min(0), vals.max(0)
        pos = x + (i - (len(runs) - 1) / 2) * width

        ax.bar(pos, mean, width * 0.92, color=colors[name], label=labels[name])
        # error bars go from the worst seed to the best seed
        ax.errorbar(pos, mean, yerr=[np.clip(mean - lo, 0, None), np.clip(hi - mean, 0, None)],
                    fmt="none", ecolor="black", elinewidth=1, capsize=3)
        for p, m, top in zip(pos, mean, hi):
            ax.text(p, top + 0.015, f"{m:.2f}", ha="center", fontsize=10)

    ax.set_xticks(x, metrics.values())
    ax.set_ylim(0, 1.1)
    ax.set_ylabel("Test score")
    ax.grid(axis="x", visible=False)
    ax.legend(frameon=False, loc="upper center", bbox_to_anchor=(0.5, -0.08), ncol=len(runs))
    ax.set_title(f"Mean of {n_seeds} seeds (error bars: worst to best seed)",
                 fontsize=11, color="#6b6a64", loc="left")
    fig.savefig(results_dir / "metrics.png")
    plt.close(fig)


def loss_curves(runs):
    fig, axes = plt.subplots(1, len(runs), figsize=(5 * len(runs), 4), sharey=True)
    axes = np.atleast_1d(axes)

    for ax, (name, rs) in zip(axes, runs.items()):
        epochs = [h["epoch"] for h in rs[0]["history"]]
        for key, style, label in [("train_loss", "--", "train"), ("val_loss", "-", "validation")]:
            vals = np.array([[h[key] for h in r["history"]] for r in rs])
            ax.plot(epochs, vals.mean(0), style, color=colors[name], lw=2, label=label)
            # shaded band = range across seeds
            ax.fill_between(epochs, vals.min(0), vals.max(0), color=colors[name], alpha=0.15, lw=0)
        ax.set_title(labels[name], loc="left")
        ax.set_xlabel("Epoch")
        ax.set_xticks(epochs)
        ax.legend(frameon=False, fontsize=10)

    axes[0].set_ylabel("Loss")
    fig.tight_layout()
    fig.savefig(results_dir / "loss_curves.png")
    plt.close(fig)


def confusion_matrices(runs):
    fig, axes = plt.subplots(1, len(runs), figsize=(4 * len(runs), 3.6))
    axes = np.atleast_1d(axes)

    for ax, (name, rs) in zip(axes, runs.items()):
        cm = np.array(rs[0]["test"]["confusion_matrix"])
        rate = cm / cm.sum(1, keepdims=True)  # shade by row so the small spam row still shows up
        ax.imshow(rate, cmap="Blues", vmin=0, vmax=1)
        for i in range(2):
            for j in range(2):
                ax.text(j, i, cm[i, j], ha="center", va="center", fontsize=15,
                        color="white" if rate[i, j] > 0.6 else "black")
        ax.set_xticks([0, 1], ["ham", "spam"])
        ax.set_yticks([0, 1], ["ham", "spam"])
        ax.set_xlabel("Predicted")
        ax.set_title(f"{labels[name]} (seed {rs[0]['seed']})", loc="left", fontsize=11)
        ax.grid(False)
        for s in ax.spines.values():
            s.set_visible(False)

    axes[0].set_ylabel("Actual")
    fig.tight_layout()
    fig.savefig(results_dir / "confusion_matrices.png")
    plt.close(fig)


if __name__ == "__main__":
    runs = load_runs()
    n_seeds = max(len(rs) for rs in runs.values())

    summary = summarize(runs)
    summary.to_csv(results_dir / "summary.csv", index=False)
    print(summary.round(3).to_string(index=False))

    table_image(summary, n_seeds)
    metrics_chart(runs, n_seeds)
    loss_curves(runs)
    confusion_matrices(runs)
    print(f"\nsaved figures to {results_dir}")